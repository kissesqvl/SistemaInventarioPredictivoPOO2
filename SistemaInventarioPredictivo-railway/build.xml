<?xml version="1.0" encoding="UTF-8"?>

<project name="SistemaInventarioPredictivo" default="default" basedir=".">

    <description>
        Builds, tests, and runs the project SistemaInventarioPredictivo.
    </description>

    <!-- Configuración principal generada por NetBeans -->
    <import file="nbproject/build-impl.xml"/>

    <!--
        Sobrescribe la configuración antigua que intentaba copiar
        el driver MSSQL mediante una referencia que ya no existe.
        
        El proyecto actualmente utiliza las librerías ubicadas
        dentro de WEB-INF/lib.
    -->

    <target depends="init"
            if="dist.ear.dir"
            name="library-inclusion-in-manifest">

        <mkdir dir="${build.web.dir}/META-INF"/>

        <manifest file="${build.web.dir}/META-INF/MANIFEST.MF"
                  mode="update"/>

    </target>

    <target depends="init"
            name="library-inclusion-in-archive"
            unless="dist.ear.dir">

        <!--
            No se copia la antigua referencia:
            file.reference.mssql-jdbc-13.6.0.jre11.jar
        -->

    </target>

</project>